# Default to LF for text files across the repo
* text=auto eol=lf

# Windows scripts should keep their committed line endings
*.bat -text
*.cmd -text
*.ps1 -text

# Shell scripts should keep LF
*.sh text eol=lf

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
